# SanjayAIHub main server config
PORT=3000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# Postgres connection string (Neon or any Postgres). Shared with the
# coding-agent service in modules/coding-agent — it falls back to this
# same file for DATABASE_URL if its own .env doesn't set one. See
# modules/coding-agent/server/env.js.
DATABASE_URL=postgres://user:password@host:5432/dbname

# URL of the standalone coding-agent service (see modules/coding-agent).
# The frontend fetches this via GET /api/config to launch it.
CODING_AGENT_URL=http://localhost:4001

# Railway deployment - Set automatically by Railway; leave unset locally.
# RENDER_EXTERNAL_URL is for Render only
# RAILWAY_STATIC_URL and RAILWAY_PUBLIC_DOMAIN are set automatically by Railway

# Optional: shared NVIDIA API key used ONLY for free/trial users on the text
# modules (chatbot, message-writer, social-content) who haven't added their
# own NVIDIA key yet. When set, those users can click "Use temporary key" to
# borrow this key for a handful of messages (capped by their existing
# per-module usage_limit, 5 by default). Leave unset to disable the feature
# entirely — users will just be asked to add their own key, as before.
NVIDIA_FREE_TIER_API_KEY=
