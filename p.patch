+              {repoPath && (
+                <span style={{ fontSize: 11, color: 'var(--text-faint)', fontFamily: 'var(--mono)' }}>{repoPath}</span>
+              )}
+              {repoError && <span style={{ fontSize: 11, color: 'var(--red)' }}>{repoError}</span>}
+            </div>
+          )}
+
+          {/* Editor */}
+          <div className="editor-container">
+            <div className="editor-header">
+              <span className="editor-path">
+                {selectedFile ? selectedFile.path : 'No file selected'}
+                {editorDirty && <span style={{ color: 'var(--amber)' }}> ●</span>}
+              </span>
+              <div className="editor-actions">
+                <button onClick={saveFile} disabled={!editorDirty || !selectedFile} className="save-btn">
+                  💾 Save
+                </button>
+              </div>
+            </div>
+            <div id="monaco-editor" ref={editorRef}></div>
+          </div>
+
+          {/* Terminal */}
+          <Terminal repoPath={repoPath} />
+        </div>
+
+        {/* Right Sidebar - Chat */}
+        <aside className="chat-sidebar">
+          <div className="chat-header">
+            <span className="chat-title">💬 AI Assistant</span>
+            <div className="model-select-inline">
+              <span style={{ fontSize: 10, color: 'var(--text-faint)' }}>Model:</span>
+              <select
+                value={chatModel?.id || ''}
+                onChange={e => {
+                  const m = models.find(mm => mm.id === e.target.value);
+                  if (m) setChatModel(m);
+                }}
+              >
+                {models.map(m => (
+                  <option key={m.id} value={m.id}>{m.label}</option>
+                ))}
+              </select>
+            </div>
+          </div>
+
+          <div className="chat-messages">
+            {chatMessages.length === 0 && (
+              <div style={{ color: 'var(--text-faint)', textAlign: 'center', padding: '20px 0' }}>
+                <div style={{ fontSize: 24, marginBottom: 8 }}>💬</div>
+                <div style={{ fontSize: 12 }}>Ask AI to generate code or create PR</div>
+              </div>
+            )}
+            {chatMessages.map((msg, i) => (
+              <div key={i} className={`chat-message ${msg.role}`}>
+                <div dangerouslySetInnerHTML={{
+                  __html: msg.loading ? '…' : (msg.content ? marked.parse(msg.content) : '')
+                }} />
+              </div>
+            ))}
+            <div ref={chatEndRef} />
+          </div>
+
+          {diffPreview && (
+            <div style={{ padding: '0 12px' }}>
+              <div className="diff-preview">
+                <div className="meta">📊 Diff Preview</div>
+                <pre>{diffPreview}</pre>
+              </div>
+            </div>
+          )}
+
+          <form className="chat-composer" onSubmit={sendMessage}>
+            <textarea
+              value={chatInput}
+              onChange={e => setChatInput(e.target.value)}
+              placeholder={!repoPath ? 'Load a repo first…' : 'Describe what you want to build...'}
+              disabled={!chatModel || !repoPath || chatLoading}
+              rows={3}
+              onKeyDown={e => {
+                if (e.key === 'Enter' && !e.shiftKey) {
+                  e.preventDefault();
+                  sendMessage(e);
+                }
+              }}
+            />
+            <button type="submit" disabled={!chatInput.trim() || !chatModel || !repoPath || chatLoading}>
+              {chatLoading ? '…' : 'Send'}
+            </button>
+          </form>
+        </aside>
+      </div>
+    </div>
+  );
+}
+
+ReactDOM.createRoot(document.getElementById('root')).render(<App />);
+
+</script>
+</body>
