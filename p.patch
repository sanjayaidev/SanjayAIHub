+const { useState, useEffect, useRef, useCallback } = React;
+
+async function fetchJSON(url, opts = {}) {
+  const res = await fetch(url, { credentials: 'same-origin', ...opts });
+  if (!res.ok) {
+    const data = await res.json().catch(() => ({}));
+    throw new Error(data.error || `HTTP ${res.status}`);
+  }
+  return res.json();
+}
+
+function joinPath(dir, name) {
+  return dir ? `${dir}/${name}` : name;
+}
+
+function dirnameOf(relPath) {
+  const idx = relPath.lastIndexOf('/');
+  return idx === -1 ? '' : relPath.slice(0, idx);
+}
+
+function duplicateName(name) {
+  const dot = name.lastIndexOf('.');
+  return dot > 0 ? `${name.slice(0, dot)} copy${name.slice(dot)}` : `${name} copy`;
+}
+
+// Context Menu Component
+function ContextMenu({ x, y, item, repoPath, onClose, onRefresh }) {
+  const [showRenameInput, setShowRenameInput] = useState(false);
+  const [newName, setNewName] = useState(item?.name || '');
+  const [menuPosition, setMenuPosition] = useState({ x, y });
+  const [showFileInput, setShowFileInput] = useState(false);
+  const [newFileName, setNewFileName] = useState('');
+  const [folderBasePath, setFolderBasePath] = useState('');
+
+  const handleCreateFile = (basePath) => {
+    setFolderBasePath(basePath);
+    setNewFileName('');
+    setShowFileInput(true);
+  };
+
+  const handleCreateFolder = (basePath) => {
+    const name = prompt('Enter folder name:');
+    if (!name || !name.trim()) return;
+    fetchJSON('/api/coding-agent/files/create-directory', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        repoPath,
+        path: joinPath(basePath, name.trim()),
+      }),
+    }).then(() => {
+      onRefresh();
+      onClose();
+    }).catch(err => {
+      console.error('Failed to create folder:', err);
+      alert('Failed to create folder: ' + err.message);
+    });
+  };
+
+  const handleCreateFileSubmit = async () => {
+    if (!newFileName.trim()) {
+      setShowFileInput(false);
+      return;
+    }
+    try {
+      await fetchJSON('/api/coding-agent/files/create-file', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          repoPath,
+          path: joinPath(folderBasePath, newFileName.trim()),
+          content: '',
+        }),
+      });
+      onRefresh();
+      onClose();
+    } catch (err) {
+      console.error('Failed to create file:', err);
+      alert('Failed to create file: ' + err.message);
+    }
+  };
+
+  useEffect(() => {
+    const handleKeyDown = (e) => {
+      if (e.key === 'Escape') onClose();
+    };
+    document.addEventListener('keydown', handleKeyDown);
+    return () => document.removeEventListener('keydown', handleKeyDown);
+  }, [onClose]);
+
+  const handleCopy = async () => {
+    try {
+      const destPath = joinPath(dirnameOf(item.path), duplicateName(item.name));
+      await fetchJSON('/api/coding-agent/files/copy', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          repoPath,
+          sourcePath: item.path,
+          destPath,
+        }),
+      });
+      onRefresh();
+      onClose();
+    } catch (err) {
+      console.error('Failed to copy:', err);
+    }
+  };
+
+  const handleDelete = async () => {
+    try {
+      await fetchJSON('/api/coding-agent/files/item', {
+        method: 'DELETE',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          repoPath,
+          path: item.path,
+        }),
+      });
+      onRefresh();
+      onClose();
+    } catch (err) {
+      console.error('Failed to delete:', err);
+    }
+  };
+
+  const handleRenameStart = () => {
+    setNewName(item.name);
+    setShowRenameInput(true);
+  };
+
+  const handleRenameSubmit = async () => {
+    if (!newName.trim() || newName === item.name) {
+      setShowRenameInput(false);
+      return;
+    }
+    try {
+      const newPath = joinPath(dirnameOf(item.path), newName);
+      await fetchJSON('/api/coding-agent/files/rename', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          repoPath,
+          oldPath: item.path,
+          newPath,
+        }),
+      });
+      onRefresh();
+      onClose();
+    } catch (err) {
+      console.error('Failed to rename:', err);
+    }
+  };
+
+  const handleMove = async () => {
+    const newDir = prompt('Enter destination directory path (relative to repo):', dirnameOf(item.path));
+    if (newDir === null) return;
+    try {
+      const destPath = joinPath(newDir, item.name);
+      await fetchJSON('/api/coding-agent/files/move', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          repoPath,
+          sourcePath: item.path,
+          destPath,
+        }),
+      });
+      onRefresh();
+      onClose();
+    } catch (err) {
+      console.error('Failed to move:', err);
+      alert('Failed to move: ' + err.message);
+    }
+  };
+
+  // Adjust position if menu goes off-screen
+  useEffect(() => {
+    const rect = { x: menuPosition.x, y: menuPosition.y };
+    const menuWidth = 180;
+    const menuHeight = 250;
+    if (rect.x + menuWidth > window.innerWidth) {
+      rect.x = window.innerWidth - menuWidth - 10;
+    }
+    if (rect.y + menuHeight > window.innerHeight) {
+      rect.y = window.innerHeight - menuHeight - 10;
+    }
+    setMenuPosition(rect);
+  }, []);
+
+  return (
+    <>
+      <div className="context-menu-overlay" onClick={onClose} />
+      <div
+        className="context-menu"
+        style={{ left: `${menuPosition.x}px`, top: `${menuPosition.y}px` }}
+      >
+        {!showRenameInput ? (
+          <>
+            <div className="context-menu-item" onClick={() => handleCreateFile(item.type === 'directory' ? item.path : dirnameOf(item.path))}>
+              📄 New File
+            </div>
+            <div className="context-menu-item" onClick={() => handleCreateFolder(item.type === 'directory' ? item.path : dirnameOf(item.path))}>
+              📁 New Folder
+            </div>
+            {item.path !== '' && (
+              <>
+                <div className="context-menu-divider" />
+                <div className="context-menu-item" onClick={handleCopy}>
+                  📋 Copy
+                </div>
+                <div className="context-menu-item" onClick={handleMove}>
+                  ➡️ Move
+                </div>
+                <div className="context-menu-item" onClick={handleRenameStart}>
+                  ✏️ Rename
+                </div>
+                <div className="context-menu-divider" />
+                <div className="context-menu-item danger" onClick={handleDelete}>
+                  🗑️ Delete
+                </div>
+              </>
+            )}
+          </>
+        ) : (
+          <div className="context-menu-input-row">
+            <input
+              type="text"
+              value={newName}
+              onChange={(e) => setNewName(e.target.value)}
+              onKeyDown={(e) => {
+                if (e.key === 'Enter') handleRenameSubmit();
+                if (e.key === 'Escape') setShowRenameInput(false);
+              }}
+              autoFocus
+            />
+            <div className="context-menu-buttons">
+              <button onClick={() => setShowRenameInput(false)}>Cancel</button>
+              <button className="primary" onClick={handleRenameSubmit}>Rename</button>
+            </div>
+          </div>
+        )}
+      </div>
+    </>
+  );
+}
+
+function FileTreeItem({ item, depth = 0, onSelect, onActivate, selectedPath, activePath, onContextMenu }) {
+  const [expanded, setExpanded] = useState(depth < 1);
+
+  const handleClick = () => {
+    onActivate(item);
+    if (item.type === 'directory') {
+      setExpanded(!expanded);
+    } else {
+      onSelect(item);
+    }
+  };
+
+  const handleRightClick = (e) => {
+    e.preventDefault();
+    e.stopPropagation();
+    onContextMenu(e.clientX, e.clientY, item);
+  };
+
+  const icon = item.type === 'directory'
+    ? (expanded ? '📂' : '📁')
+    : (item.name.endsWith('.js') || item.name.endsWith('.jsx') ? '📜' :
+       item.name.endsWith('.html') ? '🌐' :
+       item.name.endsWith('.css') ? '🎨' :
+       item.name.endsWith('.md') ? '📝' : '📄');
+
+  if (item.type === 'directory') {
+    return (
+      <div>
+        <div
+          className={`file-item ${activePath === item.path ? 'active' : ''}`}
+          onClick={handleClick}
+          onContextMenu={handleRightClick}
+          style={{ paddingLeft: `${8 + depth * 16}px` }}
+        >
+          <span className="folder-toggle">{expanded ? '▼' : '▶'}</span>
+          <span className="icon">{icon}</span>
+          <span className="name">{item.name}</span>
+        </div>
+        <div className={`folder-children ${expanded ? 'open' : ''}`}>
+          {item.children?.map(child => (
+            <FileTreeItem
+              key={child.path}
+              item={child}
+              depth={depth + 1}
+              onSelect={onSelect}
+              onActivate={onActivate}
+              selectedPath={selectedPath}
+              activePath={activePath}
+              onContextMenu={onContextMenu}
+            />
+          ))}
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div
+      className={`file-item ${selectedPath === item.path || activePath === item.path ? 'active' : ''}`}
+      onClick={handleClick}
+      onContextMenu={handleRightClick}
+      style={{ paddingLeft: `${8 + depth * 16}px` }}
+    >
+      <span className="icon">{icon}</span>
+      <span className="name">{item.name}</span>
+    </div>
+  );
+}
+
+function Terminal({ repoPath }) {
+  const [history, setHistory] = useState([
+    { type: 'info', text: 'Terminal initialized. Type commands below.' }
+  ]);
+  const [input, setInput] = useState('');
+  const bodyRef = useRef(null);
+
+  useEffect(() => {
+    if (bodyRef.current) {
+      bodyRef.current.scrollTop = bodyRef.current.scrollHeight;
+    }
+  }, [history]);
+
+  const executeCommand = async (cmd) => {
+    if (!cmd.trim()) return;
+    setHistory(prev => [...prev, { type: 'prompt', text: `$ ${cmd}` }]);
+    setInput('');
+
+    try {
+      const response = await fetch('/api/coding-agent/repos/exec', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ repoPath, command: cmd }),
+      });
+      const data = await response.json();
+      if (data.output) {
+        setHistory(prev => [...prev, { type: 'normal', text: data.output }]);
+      }
+      if (data.error) {
+        setHistory(prev => [...prev, { type: 'error', text: data.error }]);
+      }
+    } catch (error) {
+      setHistory(prev => [...prev, { type: 'error', text: error.message }]);
+    }
+  };
+
+  const handleKeyDown = (e) => {
+    if (e.key === 'Enter') {
+      executeCommand(input);
+    }
+  };
+
+  return (
+    <div className="terminal-container">
+      <div className="terminal-header">
+        <span>⌨️ Terminal</span>
+        <span style={{ fontSize: 10 }}>{repoPath || 'No repo loaded'}</span>
+      </div>
+      <div className="terminal-body" ref={bodyRef}>
+        {history.map((line, i) => (
+          <div key={i} className={`terminal-line ${line.type}`}>{line.text}</div>
+        ))}
+      </div>
+      <div className="terminal-input-row">
+        <span className="terminal-prompt">$</span>
+        <input
+          type="text"
+          className="terminal-input"
+          value={input}
+          onChange={e => setInput(e.target.value)}
+          onKeyDown={handleKeyDown}
+          placeholder="Type a command..."
+          disabled={!repoPath}
+        />
+      </div>
+    </div>
+  );
+}
+
+function App() {
+  const [models, setModels] = useState([]);
+  const [chatModel, setChatModel] = useState(null);
+  const [chatMessages, setChatMessages] = useState([]);
+  const [chatInput, setChatInput] = useState('');
+  const [chatLoading, setLoading] = useState(false);
+  const [status, setStatus] = useState({ online: true, modelCount: 0 });
+
+  const [user, setUser] = useState(null);
+  const [authChecked, setAuthChecked] = useState(false);
+  const [repos, setRepos] = useState([]);
+  const [selectedRepo, setSelectedRepo] = useState(null);
+  const [repoPath, setRepoPath] = useState('');
+  const [repoLoading, setRepoLoading] = useState(false);
+  const [repoError, setRepoError] = useState('');
+
+  const [fileTree, setFileTree] = useState([]);
+  const [selectedFile, setSelectedFile] = useState(null);
+  const [editorContent, setEditorContent] = useState('');
+  const [editorDirty, setEditorDirty] = useState(false);
+  const [diffPreview, setDiffPreview] = useState('');
+  const [contextMenu, setContextMenu] = useState(null);
+
+  const editorRef = useRef(null);
+  const monacoRef = useRef(null);
+  const chatEndRef = useRef(null);
+
+  const handleFileContextMenu = (x, y, item) => {
+    setContextMenu({ x, y, item });
+  };
+
+  const closeContextMenu = () => {
+    setContextMenu(null);
+  };
+
+  useEffect(() => {
+    fetchJSON('/api/coding-agent/agent/models')
+      .then(data => {
+        setModels(data.models || []);
+        setStatus({ online: true, modelCount: data.total || 0 });
+        if (data.models?.length) {
+          const defaultModel = data.models.find(m => m.category === 'coding') || data.models[0];
+          setChatModel(defaultModel);
+        }
+      })
+      .catch(() => setStatus({ online: false, modelCount: 0 }));
+  }, []);
+
+  useEffect(() => {
+    fetchJSON('/api/coding-agent/auth/me')
+      .then(data => setUser(data.user))
+      .catch(() => setUser(null))
+      .finally(() => setAuthChecked(true));
+  }, []);
+
+  useEffect(() => {
+    if (!user) return;
+    fetchJSON('/api/coding-agent/repos')
+      .then(data => setRepos(data.repos || []))
+      .catch(err => setRepoError(err.message));
+  }, [user]);
+
+  const loadRepo = useCallback(async () => {
+    if (!selectedRepo) return;
+    setRepoLoading(true);
+    setRepoError('');
+    try {
+      const data = await fetchJSON('/api/coding-agent/repos/clone', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          fullName: selectedRepo.fullName,
+          cloneUrl: selectedRepo.cloneUrl,
+          defaultBranch: selectedRepo.defaultBranch,
+        }),
+      });
+      setRepoPath(data.path);
+      setChatMessages(prev => [...prev, {
+        role: 'assistant',
+        content: `✅ Loaded \`${selectedRepo.fullName}\` — ready for tasks.`,
+      }]);
+      // Load file tree
+      loadFileTree(data.path);
+    } catch (err) {
+      setRepoError(err.message);
+    } finally {
+      setRepoLoading(false);
+    }
+  }, [selectedRepo]);
+
+  const loadFileTree = async (path) => {
+    try {
+      const data = await fetchJSON(`/api/coding-agent/files/tree?repoPath=${encodeURIComponent(path)}`);
+      setFileTree(data.tree || []);
+    } catch (err) {
+      console.error('Failed to load file tree:', err);
+    }
+  };
+
+  const loadFileContent = async (file) => {
+    try {
+      const data = await fetchJSON(`/api/coding-agent/files/content?repoPath=${encodeURIComponent(repoPath)}&path=${encodeURIComponent(file.path)}`);
+      setEditorContent(data.content || '');
+      setSelectedFile(file);
+      setEditorDirty(false);
+
+      if (monacoRef.current) {
+        monacoRef.current.setValue(data.content || '');
+      }
+    } catch (err) {
+      console.error('Failed to load file:', err);
+    }
+  };
+
+  const saveFile = async () => {
+    if (!selectedFile || !repoPath) return;
+    try {
+      await fetchJSON('/api/coding-agent/files/content', {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          repoPath,
+          path: selectedFile.path,
+          content: editorContent,
+        }),
+      });
+      setEditorDirty(false);
+      setChatMessages(prev => [...prev, {
+        role: 'assistant',
+        content: `✅ Saved \`${selectedFile.path}\``,
+      }]);
+    } catch (err) {
+      console.error('Failed to save file:', err);
+    }
+  };
+
+  const logout = useCallback(async () => {
+    await fetch('/api/coding-agent/auth/logout', { method: 'POST', credentials: 'same-origin' });
+    setUser(null);
+    setRepos([]);
+    setSelectedRepo(null);
+    setRepoPath('');
+    setFileTree([]);
+    setSelectedFile(null);
+  }, []);
+
+  useEffect(() => {
+    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
+  }, [chatMessages]);
+
+  useEffect(() => {
+    require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });
+    require(['vs/editor/editor.main'], function () {
+      monacoRef.current = monaco.editor.create(editorRef.current, {
+        value: editorContent,
+        language: 'javascript',
+        theme: 'vs-dark',
+        automaticLayout: true,
+        minimap: { enabled: true },
+        fontSize: 14,
+        fontFamily: 'JetBrains Mono',
+      });
+
+      monacoRef.current.onDidChangeModelContent(() => {
+        const val = monacoRef.current.getValue();
+        setEditorContent(val);
+        setEditorDirty(true);
+      });
+    });
+  }, []);
+
+  const sendMessage = useCallback(async (e) => {
+    e.preventDefault();
+    if (!chatInput.trim() || chatLoading || !chatModel || !repoPath) return;
+
+    const userMessage = chatInput.trim();
+    setChatInput('');
+    setChatMessages(prev => [...prev, { role: 'user', content: userMessage }]);
+    setLoading(true);
+
+    setChatMessages(prev => [...prev, { role: 'assistant', content: '...', loading: true }]);
+
+    try {
+      const data = await fetchJSON('/api/coding-agent/agent/run', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          repoPath,
+          task: userMessage,
+          modelId: chatModel.id,
+        }),
+      });
+
+      setDiffPreview(data.diff || '');
+
+      setChatMessages(prev => {
+        const last = prev[prev.length - 1];
+        if (last && last.loading) {
+          const content = data.success
+            ? (data.output || 'Done — no output.')
+            : `⚠️ ${data.error || 'aider reported an error'}\n\n${data.output || ''}`;
+          return [...prev.slice(0, -1), { role: 'assistant', content }];
+        }
+        return prev;
+      });
+
+      // Refresh file tree after changes
+      loadFileTree(repoPath);
+    } catch (error) {
+      setChatMessages(prev => {
+        const last = prev[prev.length - 1];
+        if (last && last.loading) {
+          return [...prev.slice(0, -1), { role: 'assistant', content: `⚠️ Error: ${error.message}` }];
+        }
+        return prev;
+      });
+    } finally {
+      setLoading(false);
+    }
+  }, [chatInput, chatLoading, chatModel, repoPath]);
+
+  const groupedModels = models.reduce((acc, m) => {
+    if (!acc[m.category]) acc[m.category] = [];
+    acc[m.category].push(m);
+    return acc;
+  }, {});
+
+  return (
+    <div className="app">
+      <header className="topbar">
+        <div className="topbar-left">
+          <div className="logo">⚡ <span>Code</span>Agent</div>
+          <span className="badge">{status.modelCount} models</span>
+        </div>
+        <div className="topbar-right">
+          <span className="badge">
+            <span className="status-dot green"></span>
+            {status.online ? 'Connected' : 'Offline'}
+          </span>
+          <span className="badge">Alibaba · SG</span>
+          {authChecked && (
+            user ? (
+              <span className="badge" style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
+                <img src={user.avatarUrl} alt="" style={{ width: 16, height: 16, borderRadius: '50%' }} />
+                {user.login}
+                <button
+                  onClick={logout}
+                  style={{ background: 'none', border: 'none', color: 'var(--text-faint)', cursor: 'pointer', fontSize: 11, padding: 0, marginLeft: 4 }}
+                >
+                  log out
+                </button>
+              </span>
+            ) : (
+              <a href="/api/coding-agent/auth/github" className="badge" style={{ textDecoration: 'none', color: 'var(--green)' }}>
+                🔗 Connect GitHub
+              </a>
+            )
+          )}
+        </div>
+      </header>
+
+      <div className="main">
+        {/* Left Sidebar - Files */}
+        <aside className="sidebar">
+          <div className="sidebar-header">
+            <span>📁 Files</span>
+            {repoPath && (
+              <div className="sidebar-header-actions">
+                <button
+                  className="sidebar-header-btn"
+                  title="New File"
+                  onClick={(e) => handleFileContextMenu(e.clientX, e.clientY, { path: '', type: 'directory', name: '' })}
+                >📄</button>
+                <button
+                  className="sidebar-header-btn"
+                  title="New Folder"
+                  onClick={(e) => handleFileContextMenu(e.clientX, e.clientY, { path: '', type: 'directory', name: '' })}
+                >📁</button>
+              </div>
+            )}
+          </div>
+          <div
+            className="file-tree"
+            onContextMenu={(e) => {
+              if (e.target === e.currentTarget && repoPath) {
