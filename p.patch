+# ── Core ──
+PORT=3000
+NODE_ENV=development
+DATABASE_URL=postgres://user:password@localhost:5432/sanjayaihub
+JWT_SECRET=change-me
+
+# ── Coding Agent module (modules/coding-agent/) ──
+# Vendored from https://github.com/sanjayaidev/CodingAgentSM, mounted at
+# /api/coding-agent. Unlike the rest of SanjayAIHub (which reads provider
+# keys per-user from the database via Profile > API Keys), this module runs
+# real `aider` subprocesses and git operations against the server's own
+# filesystem, so it uses a single shared server-side Alibaba credential
+# rather than a per-user one.
+ALIBABA_API_KEY=your_alibaba_dashscope_api_key
+ALIBABA_WORKSPACE_ID=your_alibaba_workspace_id
+
+# GitHub OAuth app used by the coding-agent module to let a user connect
+# their GitHub account and clone/push their own repos.
+# Callback URL to register with the OAuth app:
+#   {APP_BASE_URL}/api/coding-agent/auth/github/callback
+GITHUB_CLIENT_ID=your_github_oauth_client_id
+GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
+APP_BASE_URL=http://localhost:3000
+
+# Optional — falls back to SESSION_SECRET, then a dev default, if unset.
+CODING_AGENT_SESSION_SECRET=change-me-too
+
+# Optional — where cloned repos are stored on disk. Defaults to
+# ./workspace (relative to the process's cwd, i.e. the SanjayAIHub root).
+WORKSPACE_DIR=./workspace
