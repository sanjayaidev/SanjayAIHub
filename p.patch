+// modules/coding-agent/index.js
+//
+// Vendored from https://github.com/sanjayaidev/CodingAgentSM.
+// Original repo booted its own standalone `app.listen(...)`; here it's
+// adapted into a mountable sub-router so SanjayAIHub's server.js can
+// `app.use('/api/coding-agent', router)` alongside all the other modules.
+// Everything under server/ (lib, middleware, routes, utils) is untouched
+// upstream code — only this file is new.
+//
+// Kept as ESM (see package.json in this folder) since the original code
+// used `import`/`export` throughout; SanjayAIHub's server.js is CommonJS
+// and loads this module with a dynamic `import()`.
+
+import express from 'express';
+import session from 'express-session';
+
+import agentRoutes from './server/routes/agent.js';
+import authRoutes from './server/routes/auth.js';
+import repoRoutes from './server/routes/repos.js';
+import fileRoutes from './server/routes/files.js';
+import collabRoutes, { initCollaboration } from './server/routes/collaboration.js';
+import analysisRoutes from './server/routes/codeAnalysis.js';
+import { securityMiddleware, auditLogger, monitorRepoAccess } from './server/middleware/security.js';
+import { createLogger } from './server/utils/logger.js';
+
+const logger = createLogger('coding-agent');
+
+/**
+ * Build the coding-agent Express router and wire up its Socket.IO
+ * collaboration layer onto the shared HTTP server.
+ *
+ * @param {import('http').Server} httpServer - the same server instance
+ *   SanjayAIHub's server.js listens on (Socket.IO needs the raw server,
+ *   not just the Express app).
+ * @returns {{ router: import('express').Router }}
+ */
+export function createCodingAgentModule(httpServer) {
+  const router = express.Router();
+
+  // Real-time collaboration (Socket.IO) attaches directly to the shared
+  // HTTP server; requests still flow through this router for the REST side.
+  const { collaborationManager, workspaceManager } = initCollaboration(httpServer);
+  router.collaborationManager = collaborationManager;
+  router.workspaceManager = workspaceManager;
+
+  // This module's own security headers/CSP (Monaco editor workers, Socket.IO
+  // websocket connect-src, etc). Scoped to this router only — it runs after
+  // SanjayAIHub's global helmet() in server.js and simply overrides the
+  // CSP header for requests under /api/coding-agent, so the rest of the
+  // app's headers are unaffected.
+  router.use(securityMiddleware);
+
+  // This module used its own session store upstream (GitHub OAuth token +
+  // profile), separate from SanjayAIHub's JWT-based user auth — kept as-is
+  // since repo/file/agent operations here are keyed off the GitHub session,
+  // not the SanjayAIHub account.
+  router.use(session({
+    name: 'coding_agent.sid',
+    secret: process.env.CODING_AGENT_SESSION_SECRET || process.env.SESSION_SECRET || 'dev-secret-change-me',
+    resave: false,
+    saveUninitialized: false,
+    cookie: {
+      httpOnly: true,
+      secure: process.env.NODE_ENV === 'production',
+      sameSite: 'lax',
+      maxAge: 7 * 24 * 60 * 60 * 1000, // 7 days
+    },
+  }));
+
+  router.use(auditLogger);
+  router.use(monitorRepoAccess);
+
+  router.use('/agent', agentRoutes);
+  router.use('/auth', authRoutes);
+  router.use('/repos', repoRoutes);
+  router.use('/files', fileRoutes);
+  router.use('/collab', collabRoutes);
+  router.use('/analysis', analysisRoutes);
+
+  router.get('/health', (req, res) => {
+    res.json({
+      status: 'ok',
+      timestamp: new Date().toISOString(),
+      version: '2.0.0',
+      features: {
+        collaboration: true,
+        codeAnalysis: true,
+        securityEnhanced: true,
+        realTimeEditing: true,
+      },
+    });
+  });
+
+  logger.info('Coding Agent module mounted at /api/coding-agent');
+
+  return { router, collaborationManager, workspaceManager };
+}
