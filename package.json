{
  "name": "sanjayaihub",
  "version": "1.0.0",
  "description": "Unified AI Hub",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:agent": "npm --prefix modules/coding-agent start",
    "dev:agent": "npm --prefix modules/coding-agent run dev",
    "start:all": "concurrently -n main,agent -c blue,magenta \"npm run start\" \"npm run start:agent\"",
    "dev:all": "concurrently -n main,agent -c blue,magenta \"npm run dev\" \"npm run dev:agent\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "nodemon": "^3.0.2"
  }
}
