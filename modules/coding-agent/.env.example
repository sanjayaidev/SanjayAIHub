# Coding Agent runs as its own standalone service (separate ESM app with its
# own sessions + Socket.IO), not merged into SanjayAIHub's main Express app.
# Give it a distinct port so it doesn't clash with the main app (default 3000).

PORT=4001
NODE_ENV=development
SESSION_SECRET=change-me
FRONTEND_URL=http://localhost:3000

# Alibaba Model Studio credentials used by the agent's 68-model catalog.
# ALIBABA_API_KEY=
# ALIBABA_WORKSPACE_ID=

# server/lib/aider.js imports the main app's db/index.js directly (so users
# only configure their Alibaba key once, in SanjayAIHub Profile > API Keys,
# instead of duplicating it here). That shared module reads DATABASE_URL
# from this process's own environment/.env — dotenv.config() here does NOT
# inherit the main app's .env — so it must be set here too, to the SAME
# database SanjayAIHub uses.
# DATABASE_URL=
